{
  "name": "camclaude",
  "productName": "CamClaude",
  "version": "0.1.0",
  "description": "A lightweight desktop front end for Claude Code: sessions grouped by project, at-a-glance status, and automatic handoff when a session grows too large.",
  "author": "Cameron Jewell",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run.mjs electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --no-warnings --test src/main/logic.test.ts",
    "icons": "node scripts/run.mjs electron scripts/make-icons.mjs",
    "smoke":"node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "dist": "npm run typecheck && npm test && electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "qrcode": "1.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "5.9",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "com.camjewell.camclaude",
    "productName": "CamClaude",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
